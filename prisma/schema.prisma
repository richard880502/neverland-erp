generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

enum ChannelType {
  SYSTEM
  DIRECT
  CONSIGNMENT
  BUYOUT
}

enum MovementType {
  RECEIVE
  SHIP
  SALES_RETURN
  PURCHASE_RETURN
  CONSIGN_OUT
  CONSIGN_RETURN
  CONSIGN_SOLD
  BUYOUT
  DEFECT
  ADJUSTMENT
}

enum BillingStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum BillingSourceType {
  CONSIGNMENT
  BUYOUT
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         UserRole        @default(STAFF)
  active       Boolean         @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount Int         @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  totpSecretEncrypted String?
  totpEnabledAt DateTime?
  totpLastUsedStep Int?
  movements    StockMovement[]
  billingStatements BillingStatement[]
  sessions     Session[]
  auditLogs    AuditLog[]
  googleSheetSyncRuns GoogleSheetSyncRun[]
  googleSheetConnections GoogleSheetConnection[]
  totpRecoveryCodes TotpRecoveryCode[]
  loginChallenges LoginChallenge[]
  mcpConnections McpConnection[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens OAuthAccessToken[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model GoogleSheetConnection {
  id               String    @id
  spreadsheetId    String
  spreadsheetTitle String?
  lastTestedAt     DateTime?
  lastTestStatus   String?
  lastTestSource   String?
  lastTestError    String?
  automaticSyncEnabled Boolean @default(false)
  syncTimeZone     String    @default("Asia/Taipei")
  syncHour         Int       @default(3)
  syncMinute       Int       @default(0)
  updatedById      String?
  updatedBy        User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model GoogleSheetSyncRun {
  id               String    @id @default(cuid())
  mode             String
  status           String
  source           String
  spreadsheetId    String
  spreadsheetTitle String?
  sourceFetchedAt  DateTime?
  sourceDigest     String?
  summary          Json?
  items            Json?
  error            String?
  scheduleKey      String?   @unique
  requestedById    String?
  requestedBy      User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  confirmedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([mode, status, createdAt])
}

model GoogleSheetEntityState {
  id           String   @id @default(cuid())
  spreadsheetId String
  entityType   String
  entityKey    String
  sourceHash   String
  databaseHash String
  sourceRow    Int?
  lastSyncedAt DateTime @default(now())

  @@unique([spreadsheetId, entityType, entityKey])
  @@index([lastSyncedAt])
}

model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model LoginChallenge {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model McpConnection {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  clientName  String?
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  userAgent   String?
  metadata    Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]
  authorizationCodes OAuthAuthorizationCode[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([clientId])
}

model OAuthAuthorizationCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  userId        String
  connectionId  String
  clientId      String
  redirectUri   String
  codeChallenge String
  scopes        String[]
  expiresAt     DateTime
  usedAt        DateTime?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([clientId, expiresAt])
  @@index([connectionId])
}

model OAuthAccessToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  connectionId String
  clientId     String
  audience     String
  scopes       String[]
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([tokenHash])
  @@index([connectionId, revokedAt])
  @@index([expiresAt])
}

model OAuthRefreshToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  connectionId String
  clientId     String
  scopes       String[]
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([tokenHash])
  @@index([connectionId, revokedAt])
  @@index([expiresAt])
}

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String[]
  applicationType String @default("web")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model McpPreparedAction {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  kind         String
  payload      Json
  userId       String
  connectionId String
  clientId     String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([connectionId, consumedAt])
  @@index([expiresAt])
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  size        String?
  safetyStock Int             @default(0)
  listPrice   Decimal?        @db.Decimal(12, 2)
  wholesalePrice Decimal?     @db.Decimal(12, 2)
  unitCost    Decimal?        @db.Decimal(12, 2)
  description String?
  imagePath   String?
  imageThumbPath String?
  active      Boolean         @default(true)
  movements   StockMovement[]
  billingItems BillingStatementItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Channel {
  id        String          @id @default(cuid())
  name      String          @unique
  type      ChannelType
  active    Boolean         @default(true)
  companyName String?
  taxId String?
  contactName String?
  contactEmail String?
  contactPhone String?
  billingAddress String?
  settlementRate Decimal?   @db.Decimal(6, 4)
  taxRate Decimal?          @db.Decimal(6, 4)
  paymentTermsDays Int?     @default(0)
  movements StockMovement[]
  billingStatements BillingStatement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model StockMovement {
  id           String          @id @default(cuid())
  occurredAt   DateTime
  type         MovementType
  quantity     Int
  unitPrice    Decimal?        @db.Decimal(12, 2)
  referenceNo  String?
  note         String?
  productId    String
  channelId    String?
  createdById  String
  reversalOfId String?         @unique
  reversedAt   DateTime?
  product      Product         @relation(fields: [productId], references: [id])
  channel      Channel?        @relation(fields: [channelId], references: [id])
  createdBy    User            @relation(fields: [createdById], references: [id])
  reversalOf   StockMovement?  @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversal     StockMovement?  @relation("MovementReversal")
  googleSheetQueue GoogleSheetMovementQueue?
  billingSource BillingStatementSource?
  createdAt    DateTime        @default(now())

  @@index([productId, occurredAt])
  @@index([channelId, occurredAt])
  @@index([type, occurredAt])
}

model GoogleSheetMovementQueue {
  id              String        @id @default(cuid())
  movementId      String        @unique
  movement        StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  status          String        @default("PENDING")
  attempts        Int           @default(0)
  nextAttemptAt   DateTime      @default(now())
  processingToken String?
  lastError       String?
  spreadsheetId   String?
  sheetRow        Int?
  syncedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, nextAttemptAt])
  @@index([processingToken])
  @@index([createdAt])
}

model BillingStatement {
  id                String            @id @default(cuid())
  statementNo       String            @unique
  channelId         String
  sourceType        BillingSourceType
  periodStart       DateTime
  periodEnd         DateTime
  issuedAt          DateTime
  dueDate           DateTime?
  companyName       String
  taxId             String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  billingAddress    String?
  settlementRate    Decimal           @db.Decimal(6, 4)
  taxRate           Decimal           @db.Decimal(6, 4)
  subtotal          Decimal           @db.Decimal(12, 2)
  taxAmount         Decimal           @db.Decimal(12, 2)
  shippingFee       Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  status            BillingStatus     @default(ISSUED)
  paidAt            DateTime?
  paidAmount        Decimal?          @db.Decimal(12, 2)
  paymentMethod     String?
  paymentReference  String?
  note              String?
  createdById       String
  channel           Channel           @relation(fields: [channelId], references: [id])
  createdBy         User              @relation(fields: [createdById], references: [id])
  items             BillingStatementItem[]
  sources           BillingStatementSource[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([channelId, periodStart, periodEnd])
  @@index([status, issuedAt])
}

model BillingStatementItem {
  id            String           @id @default(cuid())
  statementId   String
  productId     String?
  sku           String
  productName   String
  size          String?
  listPrice     Decimal          @db.Decimal(12, 2)
  settlementPrice Decimal        @db.Decimal(12, 2)
  quantity      Int
  subtotal      Decimal          @db.Decimal(12, 2)
  statement     BillingStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([statementId])
  @@index([productId])
}

model BillingStatementSource {
  id          String           @id @default(cuid())
  statementId String
  movementId  String           @unique
  statement   BillingStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  movement    StockMovement    @relation(fields: [movementId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([statementId])
}
