DATABASE_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow?schema=public"
ADMIN_NAME="系統管理員"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
TOTP_ENCRYPTION_KEY="646d392c966a5c2eb660394e26da5d252d1028246722ccac049fc49757e09750"
# 商品圖片只存放在 S3-compatible MinIO；S3_PUBLIC_ENDPOINT 必須可由瀏覽器連線。
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin-change-me"
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BUCKET="neverland-erp"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin-change-me"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
S3_SIGNED_URL_TTL_SECONDS="900"
# 僅供把既有 /data/uploads 圖片遷移到 MinIO 時使用，平時不需設定。
# LEGACY_UPLOAD_DIR="/data/uploads"
GOOGLE_SHEET_ID="121W1NjIfpNk_nDX9TcpjtiaqokXKLwaOoPujQRoKaRE"
# 正式環境擇一設定：
# Service Account 必須以「編輯者」加入目標試算表，庫存異動 Queue 才能寫回。
# GOOGLE_SERVICE_ACCOUNT_JSON="base64 encoded service-account.json"
# GOOGLE_SERVICE_ACCOUNT_EMAIL="erp-sync@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_SYNC_ENABLED="false"
GOOGLE_SHEET_SYNC_TIME_ZONE="Asia/Taipei"
GOOGLE_SHEET_SYNC_HOUR="3"
GOOGLE_SHEET_SYNC_MINUTE="0"
# 本地 Demo 可省略；開發環境預設讀取 prisma/google-sheet-data.json
# GOOGLE_SHEETS_DEMO_FILE="./prisma/google-sheet-data.json"
